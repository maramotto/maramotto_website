---
title: "Pensamientos"
description: "Reflexiones y notas personales de maramotto."
permalink: /blog/thoughts/
lang: es
category: thoughts
eleventyExcludeFromCollections: true
layout: layouts/list.njk
---
{% from "partials/blog-categories.njk" import categoryNav %}
<section class="blog-list">
  <h1>{{ title }}</h1>
  {{ categoryNav(lang, category) }}
  <div class="blog-list__grid">
    {% set posts = collections.posts | postsByLang(lang) | postsByCategory(category) %}
    {% for post in posts %}
      {% include "partials/post-card.njk" %}
    {% endfor %}
  </div>
</section>
