---
layout: layouts/root-page.njk
slug: ""
isHome: true
---

  <!-- ======= HERO ======= -->
  <section class="hero">
    <div class="hero__wave" aria-hidden="true">&#12336;&#65039;&#12336;&#65039;&#12336;&#65039;</div>
    <h1 class="hero__title">maramotto</h1>
    <p class="hero__subtitle">{{ "hero.subtitle" | t(lang) }}</p>
    <p class="hero__description">{{ "hero.description" | t(lang) }}</p>
    <div class="btn-group btn-group--center">
      <a href="#projects" class="btn btn--primary">{{ "hero.cta.work" | t(lang) }}</a>
      <a href="#about" class="btn btn--outline">{{ "hero.cta.about" | t(lang) }}</a>
    </div>
  </section>

  <!-- ======= FEATURED: CUERPOSONORO ======= -->
  <section class="section section--white" id="projects">
    <div class="container">
      <div class="section-label">{{ "featured.label" | t(lang) }}</div>
      <div class="featured">
        <div class="featured__visual">
          <img src="/img/cuerposonoro-visual.svg" alt="CuerpoSonoro &mdash; Body becomes sound" class="featured__visual-img">
          <div class="featured__visual-label">{{ "featured.visual.label" | t(lang) }}</div>
        </div>
        <div class="featured__content">
          <h3>CuerpoSonoro</h3>
          <p>{{ "featured.desc.1" | t(lang) }}</p>
          <div class="tags">
            <span class="tag">Python</span>
            <span class="tag">JavaScript</span>
            <span class="tag">{{ "featured.tag.creative" | t(lang) }}</span>
            <span class="tag">{{ "featured.tag.sound" | t(lang) }}</span>
          </div>
          <a href="{{ '/en/cuerposonoro/' if lang == 'en' else '/cuerposonoro/' }}" class="btn btn--primary btn--small">{{ "featured.cta" | t(lang) }}</a>
        </div>
      </div>

      <div class="projects-grid" style="margin-top: 3rem;">

        <div class="card card--wip">
          <h3>Estratos</h3>
          <p style="font-style: italic; color: var(--text-light); font-size: 0.85rem; margin-bottom: 0.75rem;">{{ "estratos.tagline" | t(lang) }}</p>
          <p>{{ "estratos.desc" | t(lang) }}</p>
          <div class="tags">
            <span class="tag">{{ "estratos.tag.opendata" | t(lang) }}</span>
            <span class="tag">{{ "estratos.tag.sonification" | t(lang) }}</span>
            <span class="tag">{{ "estratos.tag.installation" | t(lang) }}</span>
          </div>
          <p style="font-size: 0.75rem; font-weight: 700; color: var(--text-light); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem;">{{ "estratos.status" | t(lang) }}</p>
          <a href="mailto:hello@maramotto.com?subject=Estratos" class="card__link">{{ "estratos.status.cta" | t(lang) }}</a>
        </div>

        <div class="card">
          <h3>Universo Punzadas</h3>
          <p style="font-style: italic; color: var(--text-light); font-size: 0.85rem; margin-bottom: 0.75rem;">{{ "punzadas.tagline" | t(lang) }}</p>
          <p>{{ "punzadas.desc" | t(lang) | safe }}</p>
          <div class="tags">
            <span class="tag">{{ "punzadas.tag.data" | t(lang) }}</span>
            <span class="tag">Astro</span>
            <span class="tag">{{ "punzadas.tag.search" | t(lang) }}</span>
            <span class="tag">{{ "punzadas.tag.dataviz" | t(lang) }}</span>
          </div>
          <a href="/universo-punzadas/" class="card__link">{{ "punzadas.link" | t(lang) }}</a>
        </div>

      </div>
    </div>
  </section>

  <!-- ======= ABOUT + CONTACT (merged) ======= -->
  <section class="section section--purple" id="about">
    <div class="container--narrow">
      <div class="section-label">{{ "about.label" | t(lang) }}</div>
      <h2 class="section-title">{{ "about.title" | t(lang) }}</h2>
      <p class="about-text">{{ "about.p1" | t(lang) }}</p>
      <p class="about-text">{{ "about.p2" | t(lang) }}</p>
      <p class="about-text">{{ "about.p3" | t(lang) }}</p>
      <p class="about-text">{{ "about.p4" | t(lang) }}</p>
      <p class="about-text">{{ "about.p5" | t(lang) }}</p>

      <div class="text-center" style="margin-top: 4rem;">
        <div class="section-label">{{ "contact.label" | t(lang) }}</div>
        <h2 class="section-title">{{ "contact.title" | t(lang) }}</h2>
        <p class="about-text">{{ "contact.desc" | t(lang) | safe }}</p>
        <a href="mailto:hello@maramotto.com" class="btn btn--yellow">{{ "contact.cta" | t(lang) }}</a>
        <p style="margin-top: 1rem; font-size: 0.95rem; color: rgba(255, 255, 255, 0.7);">
          <a href="mailto:hello@maramotto.com" style="color: inherit; text-decoration: underline;">hello@maramotto.com</a>
        </p>
        <div class="social-links">
          <a href="https://github.com/maramotto" class="social-link" title="GitHub" aria-label="GitHub" target="_blank" rel="noopener">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/mara-crespo/" class="social-link" title="LinkedIn" aria-label="LinkedIn" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ======= SKILLS ======= -->
  <section class="section section--white">
    <div class="container">
      <div class="section-label text-center">{{ "skills.label" | t(lang) }}</div>
      <h2 class="section-title text-center">{{ "skills.title" | t(lang) }}</h2>
      <div class="skills-grid">
        <div class="skill-card">
          <img src="/img/skill-code.svg" alt="" class="skill-card__img">
          <h3>{{ "skill.code.title" | t(lang) }}</h3>
          <p>{{ "skill.code.desc" | t(lang) }}</p>
        </div>
        <div class="skill-card">
          <img src="/img/skill-music.svg" alt="" class="skill-card__img">
          <h3>{{ "skill.music.title" | t(lang) }}</h3>
          <p>{{ "skill.music.desc" | t(lang) }}</p>
        </div>
        <div class="skill-card">
          <img src="/img/skill-techart.svg" alt="" class="skill-card__img">
          <h3>{{ "skill.techart.title" | t(lang) }}</h3>
          <p>{{ "skill.techart.desc" | t(lang) }}</p>
        </div>
        <div class="skill-card">
          <img src="/img/skill-visual.svg" alt="" class="skill-card__img">
          <h3>{{ "skill.visual.title" | t(lang) }}</h3>
          <p>{{ "skill.visual.desc" | t(lang) }}</p>
        </div>
        <div class="skill-card">
          <img src="/img/skill-workshops.svg" alt="" class="skill-card__img">
          <h3>{{ "skill.workshops.title" | t(lang) }}</h3>
          <p>{{ "skill.workshops.desc" | t(lang) }}</p>
        </div>
      </div>
    </div>
  </section>
