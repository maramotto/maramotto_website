---
layout: layouts/base.njk
fullTitle: true
eleventyExcludeFromCollections: true
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ '/en/workshops.html' if lang == 'en' else '/talleres.html' }}"
eleventyComputed:
  esUrl: "/talleres.html"
  enUrl: "/en/workshops.html"
  ogLocaleAlternate: "{{ 'es_ES' if lang == 'en' else 'en_GB' }}"
---

<!-- ======= HERO ======= -->
<section class="section section--purple">
  <div class="container--narrow text-center">
    <div class="section-label">{{ "workshops.label" | t(lang) }}</div>
    <h1 class="section-title">{{ "workshops.title" | t(lang) }}</h1>
    <p class="about-text">{{ "workshops.intro" | t(lang) }}</p>
  </div>
</section>

<!-- ======= DETALLES ======= -->
<section class="section section--white">
  <div class="container--narrow">
    <div class="card">
      <h3>{{ "workshops.format.title" | t(lang) }}</h3>
      <p>{{ "workshops.format.body" | t(lang) }}</p>
    </div>
    <div class="card" style="margin-top: 2rem;">
      <h3>{{ "workshops.forwho.title" | t(lang) }}</h3>
      <p>{{ "workshops.forwho.body" | t(lang) }}</p>
    </div>
    <div class="card" style="margin-top: 2rem;">
      <h3>{{ "workshops.outcome.title" | t(lang) }}</h3>
      <p>{{ "workshops.outcome.body" | t(lang) }}</p>
    </div>
  </div>
</section>

<!-- ======= CONTACTO ======= -->
<section class="section section--yellow text-center">
  <div class="container--narrow">
    <h2 class="section-title">{{ "workshops.cta.title" | t(lang) }}</h2>
    <p class="about-text">{{ "workshops.cta.body" | t(lang) }}</p>
    <a href="mailto:hello@maramotto.com?subject=Talleres" class="btn btn--primary">{{ "workshops.cta.button" | t(lang) }}</a>
  </div>
</section>
